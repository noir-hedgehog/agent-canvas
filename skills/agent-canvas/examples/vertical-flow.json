{
  "id": "vertical-flow",
  "description": "Editable top-to-bottom flow with bottom-to-top ports and a fixed left-side review loop.",
  "calls": [
    {
      "tool": "apply_changes",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "requestId": "${RUN}:init",
        "summary": "Create example flow graph",
        "operations": [
          {
            "op": "create",
            "id": "${RUN}:graph",
            "kind": "graph",
            "canvasId": "${CANVAS_ID}",
            "data": {
              "title": "Review flow",
              "graphType": "flow"
            }
          }
        ]
      }
    },
    {
      "tool": "create_content",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "canvasId": "${CANVAS_ID}",
        "kind": "flow",
        "data": {
          "title": "Start",
          "body": "",
          "graphId": "${RUN}:graph",
          "shape": "terminal"
        },
        "x": 180,
        "y": 100,
        "width": 260,
        "height": 150,
        "requestId": "${RUN}:start"
      }
    },
    {
      "tool": "create_content",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "canvasId": "${CANVAS_ID}",
        "kind": "flow",
        "data": {
          "title": "Prepare draft",
          "body": "",
          "graphId": "${RUN}:graph",
          "shape": "process"
        },
        "x": 180,
        "y": 360,
        "width": 260,
        "height": 150,
        "requestId": "${RUN}:work"
      }
    },
    {
      "tool": "create_content",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "canvasId": "${CANVAS_ID}",
        "kind": "flow",
        "data": {
          "title": "Approved?",
          "body": "",
          "graphId": "${RUN}:graph",
          "shape": "decision"
        },
        "x": 180,
        "y": 620,
        "width": 260,
        "height": 150,
        "requestId": "${RUN}:review"
      }
    },
    {
      "tool": "create_content",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "canvasId": "${CANVAS_ID}",
        "kind": "flow",
        "data": {
          "title": "Complete",
          "body": "",
          "graphId": "${RUN}:graph",
          "shape": "terminal"
        },
        "x": 180,
        "y": 880,
        "width": 260,
        "height": 150,
        "requestId": "${RUN}:end"
      }
    },
    {
      "tool": "apply_changes",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "requestId": "${RUN}:edges",
        "summary": "Connect flow and review loop",
        "operations": [
          {
            "op": "create",
            "id": "${RUN}:edge-1",
            "kind": "edge",
            "canvasId": "${CANVAS_ID}",
            "data": {
              "graphId": "${RUN}:graph",
              "source": "${RUN}:start:content",
              "target": "${RUN}:work:content",
              "label": "",
              "sourceSide": "bottom",
              "targetSide": "top"
            }
          },
          {
            "op": "create",
            "id": "${RUN}:edge-2",
            "kind": "edge",
            "canvasId": "${CANVAS_ID}",
            "data": {
              "graphId": "${RUN}:graph",
              "source": "${RUN}:work:content",
              "target": "${RUN}:review:content",
              "label": "Submit",
              "sourceSide": "bottom",
              "targetSide": "top"
            }
          },
          {
            "op": "create",
            "id": "${RUN}:edge-3",
            "kind": "edge",
            "canvasId": "${CANVAS_ID}",
            "data": {
              "graphId": "${RUN}:graph",
              "source": "${RUN}:review:content",
              "target": "${RUN}:end:content",
              "label": "Yes",
              "sourceSide": "bottom",
              "targetSide": "top"
            }
          },
          {
            "op": "create",
            "id": "${RUN}:edge-4",
            "kind": "edge",
            "canvasId": "${CANVAS_ID}",
            "data": {
              "graphId": "${RUN}:graph",
              "source": "${RUN}:review:content",
              "target": "${RUN}:work:content",
              "label": "No: revise",
              "sourceSide": "left",
              "targetSide": "left"
            }
          }
        ]
      }
    },
    {
      "tool": "read_canvas",
      "arguments": {
        "projectId": "${PROJECT_ID}",
        "canvasId": "${CANVAS_ID}"
      }
    }
  ]
}
